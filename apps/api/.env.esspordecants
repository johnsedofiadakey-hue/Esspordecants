# Non-secret settings for the deployed function in project "esspordecants".
# Firebase CLI loads this file automatically on deploy. Never put secrets here.
# The custom domain comes first: it is the site URL used for Paystack's return page and the sitemap.
PUBLIC_BASE_URL=https://esspordecantsgh.com
STOREFRONT_ORIGINS=https://esspordecantsgh.com,https://www.esspordecantsgh.com,https://esspordecants.web.app,https://esspordecants.firebaseapp.com
MEDIA_BUCKET=esspordecants-media
CHECKOUT_ENABLED=true
# Name of the Secret Manager secret holding the Paystack secret key (the name, not the key).
PAYSTACK_SECRET_NAME=paystack-secret-key
