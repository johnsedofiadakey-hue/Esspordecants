# Local development against the Firebase emulators (npm run emulators). No secrets.
# The demo- prefix keeps the emulators fully offline.
GCLOUD_PROJECT=demo-esspor
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBLIC_BASE_URL=http://localhost:4000
MEDIA_BUCKET=esspordecants-media
CHECKOUT_ENABLED=false
